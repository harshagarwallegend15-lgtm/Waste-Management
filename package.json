{
  "name": "wastewise",
  "version": "1.0.0",
  "description": "Community waste-management accountability and incentive system — verified collections, society scores, challenges, and a municipal dashboard.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server/index.cjs",
    "dev": "node --watch server/index.cjs",
    "seed": "node scripts/seed.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:cv": "node --test tests/cv.test.cjs",
    "test:garbage": "node --test tests/garbage.test.cjs",
    "test:challenges": "node --test tests/challenges.test.cjs",
    "test:e2e": "node tests/e2e.cjs",
    "test:supplement": "node tests/supplement.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "groq-sdk": "^1.5.0",
    "multer": "^2.0.2",
    "sharp": "^0.34.3"
  }
}
