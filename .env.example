# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq (AI vision for low-confidence photo matching + garbage-photo gate) - optional
GROQ_API_KEY=
# Optional: override the vision model (default: llama-3.2-90b-vision-preview)
# GROQ_VISION_MODEL=llama-3.2-90b-vision-preview
# Optional: AI request timeout in ms (default 25000)
# AI_TIMEOUT_MS=25000

# Garbage-photo gate: only photos that plausibly show waste are accepted at
# capture time (resident before-photo, collector after-photo, dumping reports).
# Score < GARBAGE_AI_MIN -> rejected locally. >= GARBAGE_LOCAL_MIN -> accepted.
# In between -> confirmed by Groq vision when a key is set, otherwise accepted.
# Set GARBAGE_PHOTO_CHECK=false to disable the gate entirely.
# GARBAGE_PHOTO_CHECK=true
# GARBAGE_LOCAL_MIN=0.62
# GARBAGE_AI_MIN=0.30

# CV verification thresholds (all optional, sensible defaults shown)
# Local score >= this -> auto-verified without AI (default 0.82)
# CV_VERIFIED=0.82
# Scores in [this, CV_VERIFIED) -> sent to the Groq vision model (default 0.55)
# CV_AI_MIN=0.55
# GPS distance (m) between before/after photos (default 300)
# CV_GPS_MAX_M=300
# Max hours between resident before-photo and collector after-photo (default 72)
# CV_TIME_MAX_H=72

# Society "in your city" radius in km for the resident signup dropdown and the
# nearby-societies list (default 5)
# SOCIETY_CITY_RADIUS_KM=5

# Server
PORT=8080
